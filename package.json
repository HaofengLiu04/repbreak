{
  "name": "rep-break",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --go --port 8094",
    "start:dev": "expo start --dev-client --port 8094",
    "ios": "expo start --ios --port 8094",
    "android": "expo start --android --port 8094",
    "web": "expo start --web --port 8094",
    "news:proxy": "node server/news-proxy.js",
    "doctor": "npx expo-doctor",
    "build:ios:preview": "npx eas-cli build --platform ios --profile preview",
    "build:ios:production": "npx eas-cli build --platform ios --profile production",
    "start:tunnel": "expo start --go --tunnel --port 8094"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "babel-preset-expo": "~57.0.0",
    "cors": "^2.8.6",
    "expo": "^57.0.20",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.16",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "express": "^5.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3"
  }
}
